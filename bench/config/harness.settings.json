{
 "hooks": {
  "SessionStart": [
   {
    "matcher": "startup|resume|clear|compact",
    "hooks": [
     {
      "type": "command",
      "command": "~/.cargo/bin/mem-harness",
      "args": [
       "hook",
       "session-start"
      ]
     }
    ]
   }
  ],
  "SubagentStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "~/.cargo/bin/mem-harness",
      "args": [
       "hook",
       "subagent-start"
      ]
     }
    ]
   }
  ]
 }
}